# .env de PRODUÇÃO (Hostinger). Copie para ".env" no servidor e preencha os campos marcados.
# Chaves de integração (Nixfy, Resend, Meta, Google, TikTok, UTMify) NÃO vão aqui:
# cadastre em Admin → Configurações da loja (ficam criptografadas no banco).

APP_NAME="ForFit"
APP_ENV=production
APP_DEBUG=false
# gere com: php artisan key:generate  (NUNCA troque depois: as chaves salvas no admin dependem dela)
APP_KEY=
APP_URL=https://lojaforfit.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# hPanel → Bancos de dados → MySQL (preencha)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Arquivos: mais rápido que banco na hospedagem compartilhada
SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# E-mail: Resend (a chave é cadastrada no admin)
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="contato@lojaforfit.com.br"
MAIL_FROM_NAME="ForFit"

# Velocidade e segurança (padrões de produção; só mude se souber o motivo)
PAGE_CACHE=true
ADMIN_REQUIRE_2FA=true
NIXFY_SANDBOX=false

VITE_APP_NAME="${APP_NAME}"
